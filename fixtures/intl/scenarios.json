     "do": "put_draft",
     "text": "Hello! Could you tell me what you are looking for?",
     "option_id": null,
     "expect": {
      "ok": true
     }
    },
    {
     "do": "send",
     "manual": true,
     "expect": {
      "ok": true,
      "status": "sent",
      "appended": "STOP-строка без AI-note"
     }
    },
    {
     "do": "inbound",
     "channel": "wa_sim",
     "sender_id": "sim:s3b",
     "property_id": "P1",
     "text": "Can I view it Friday?",
     "expect": {
      "status": "pending_approval"
     }
    },
    {
     "do": "reject",
     "expect": {
      "status": "review",
      "draft_cleared": true
     }
    },
    {
     "do": "put_draft",
     "text": "Hi, Friday 11:00 works if you confirm with the broker.",
     "option_id": null,
     "expect": {
      "ok": true
     }
    },
    {
     "do": "send",
     "manual": true,
     "expect": {
      "ok": true,
      "status": "sent"
     }
    },
    {
     "do": "inbound",
     "channel": "wa_sim",
     "sender_id": "sim:s3c",
     "property_id": "P1",
     "text": "STOP",
     "expect": {
      "status": "stopped"
     }
    },
    {
     "do": "send",
     "manual": true,
     "expect": {
      "http": 409,
      "error_code": "lead_stopped"
     }
    }
   ]
  },
  {
