 "scenarios": [
  {
   "id": "SC1",
   "name": "Второе сообщение клиента (S11, 5.1а)",
   "steps": [
    {
     "do": "inbound",
     "channel": "wa_sim",
     "sender_id": "sim:s1",
     "property_id": "P1",
     "text": "Is the Marina flat still available?",
     "expect": {
      "intent": "avail",
      "status": "pending_approval",
      "options": "3-4"
     }
    },
    {
     "do": "send",
     "option": "any",
     "expect": {
      "ok": true,
      "status": "sent"
     }
    },
    {
     "do": "inbound",
     "channel": "wa_sim",
     "sender_id": "sim:s1",
     "property_id": "P1",
     "text": "Can you do 100,000 AED per year? Can I see it tomorrow?",
     "expect": {
      "same_lead": true,
      "intent": "viewing",
      "also": [
       "price"
      ],
      "budget": {
       "amount": 100000,
       "currency": "AED",
       "period": "year"
      },
      "timing_class": "concrete",
      "draft_reset": true,
      "status": "pending_approval",
      "options": "3-4"
     }
    },
    {
     "do": "send",
     "option": "same_text_as_first_send_if_template_equal",
     "expect": {
      "ok": true,
      "note": "повтор того же шаблона после нового сообщения клиента разрешён (reply_to_message_id другой)"
     }
    }
   ]
  },
  {
   "id": "SC2",
   "name": "Отказ действует на все лиды отправителя (5.1б)",
   "steps": [
    {
     "do": "inbound",
     "channel": "telegram",
     "sender_id": "tg:9200000001",
     "property_id": "P1",
     "text": "Can I view the flat Friday?",
     "expect": {
      "status": "pending_approval"
     }
    },
    {
     "do": "inbound",
     "channel": "telegram",
     "sender_id": "tg:9200000002",
     "property_id": "P1",
     "text": "Is it available?",
     "expect": {
      "status": "pending_approval",
      "note": "другой отправитель"
     }
    },
    {
     "do": "inbound",
     "channel": "telegram",
     "sender_id": "tg:9200000001",
     "property_id": "P1",
     "text": "STOP",
     "expect": {
      "status": "stopped",
      "optout": true
     }
    },
    {
     "do": "inbound",
     "channel": "telegram",
     "sender_id": "tg:9200000001",
     "property_id": "P2",
     "text": "What is the price?",
     "expect": {
      "new_lead": true,
      "status": "stopped",
      "options": 0
     }
    },
    {
     "do": "send",
     "lead": "sender 9200000001 / P1",
     "expect": {
      "http": 409,
      "error_code": "lead_stopped"
     }
    },
    {
     "do": "check",
     "lead": "sender 9200000002",
     "expect": {
      "status": "pending_approval",
      "optout": false
     }
    }
   ]
  },
  {
   "id": "SC3",
   "name": "Ручной ответ из review достижим (N1)",
   "steps": [
    {
     "do": "inbound",
     "channel": "wa_sim",
     "sender_id": "sim:s3",
     "property_id": "P4",
