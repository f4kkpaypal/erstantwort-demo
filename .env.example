# Anfragen-Autopilot — Loom-срез.
# Скопируйте в .env командой: python3 scripts/init_env.py
# Пока ключей нет, оставьте режимы mock/file/log. Стек поднимается без секретов.
# Для записи Loom переключите SEND_MODE=auto и живые режимы только когда ключи уже лежат здесь.

GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# approve: ничего не уходит лиду без Freigeben. auto: ответ уходит сам. Для Loom — auto.
SEND_MODE=approve
# remind: по таймауту снова пинговать маклера в Telegram. send_fallback в этом срезе не используется.
APPROVAL_TIMEOUT_ACTION=remind

# Оба выключены. Включать только после согласия получателя (UWG §7). Отправщиков в этом срезе нет.
FOLLOWUP_EMAIL_ENABLED=false
NOSHOW_REOFFER_ENABLED=false
INTERESSE_FOLLOWUP_ENABLED=false

RETENTION_DAYS_LEAD=180
# Как часто процесс сам удаляет просроченные заявки. Хеш STOP не удаляется.
RETENTION_INTERVAL_HOURS=6
FIRST_RESPONSE_SLA_SECONDS=300
MAX_REPLIES_PER_HOUR=30
# International test mode. Empty allow-lists mean nobody is admitted.
PRODUCT_MODE=de
CHANNEL_MODE=sim
REAL_DATA_ALLOWED=false
TG_TEST_LEAD_IDS=
BROKER_TZ=Asia/Dubai
DIGEST_TIME=08:30
AED_PER_USD=3.6725
LLM_TIMEOUT_MS=5000
EPHEMERAL_DISK=false
# Сумма tokens_in и tokens_out за календарный день Europe/Berlin. При достижении Mistral не вызывается, письмо берётся из шаблона, в журнал пишется LLM_BUDGET.
LLM_DAILY_TOKEN_BUDGET=200000

# init_env.py подставит случайные значения, если здесь ещё заглушки.
HASH_SALT=change-me-hash-salt
N8N_ENCRYPTION_KEY=change-me-encryption-key
ADMIN_TOKEN=change-me-admin-token
ENGINE_TOKEN=change-me-engine-token
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-postgres

# Только уведомления ImmoScout24. Пустое значение тоже означает этот домен.
ALLOWED_SENDER_DOMAINS=immobilienscout24.de
# Канал собственников выключен, пока нет настоящих образцов писем.
OWNER_LEADS_ENABLED=false
# Письма собственников (хотят продать). Пусто = не принимаются.
# Формат: quelle:domain через запятую. Домены задаёте вы, в коде их нет.
# Пример выдуманный: immowelt:owner-immowelt.example,heimziel:owner-heimziel.example,generic:owner-lead.example
# Парсер ждёт метку Annahme-Format. Это не образец настоящего письма Immowelt или Heimziel.
OWNER_LEAD_SENDER_DOMAINS=
# Пусто: в OFFICE_MODE=live включено, в demo выключено.
# Заголовок Authentication-Results внутри письма не считается доказательством.
REQUIRE_DKIM_PASS=
# Пусто: получатель только адрес из XML или Reply-To. Алиасы портала — сюда, через запятую.
# Если список задан, домен получателя должен быть в нём. Совпадение адреса с самим собой список не открывает.
ALLOWED_RECIPIENT_RELAY_DOMAINS=
# false: лимит анкеты по адресу соединения. true: один доверенный прокси, правый адрес в X-Forwarded-For.
# В docker-compose для engine и web стоит true, потому что снаружи Caddy.
TRUST_PROXY=false

# mock | live. В live запрещены модели со словом labs.
LLM_MODE=mock
LLM_BASE_URL=https://api.mistral.ai/v1
# Одна модель на разбор и текст. LLM_MODEL_EXTRACT и LLM_MODEL_WRITE перекрывают её, если заданы.
# Рекомендуется mistral-small-latest. Бесплатный тариф часто её блокирует — тогда ministral-8b-latest.
LLM_MODEL=mistral-small-latest
LLM_MODEL_EXTRACT=
LLM_MODEL_WRITE=
LLM_SCHEMA_MODE=spec
# true добавляет в немецкий ответ строку «Gerne können Sie uns auch auf Englisch antworten.»
OFFER_ENGLISH_REPLY=false

# Mini App. false: только Telegram initData и белый список. true: обычный браузер, только если почта и Telegram не боевые.
DEMO_UI_NO_AUTH=false
UI_INITDATA_MAX_AGE_S=3600
UI_PUBLIC_BASE=http://127.0.0.1:18791
UI_MINUTES_PER_REPLY=5
UI_MINUTES_PER_BOOKING=10
# Белый список Telegram user id маклера, через запятую. Плюс MAKLER_PROFILE.telegram_user_id.
TELEGRAM_ALLOWED_USER_IDS=
# Анкета в первом ответе. Доход, число жильцов, SCHUFA и занятость по умолчанию выключены.
FRAGEBOGEN_ENABLED=true
FRAGEBOGEN_BUDGET_ENABLED=false
FRAGEBOGEN_INCOME_ENABLED=false
FRAGEBOGEN_PERSONS_ENABLED=false
FRAGEBOGEN_SCHUFA_ENABLED=false
FRAGEBOGEN_EMPLOYMENT_ENABLED=false
FRAGEBOGEN_LINK_DAYS=14
MISTRAL_API_KEY=

# mock | google
CALENDAR_MODE=mock
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# file | sheets | memory. CRM этого среза — Google Sheet. Propstack не подключён.
CRM_MODE=file
CRM_TARGET=sheets
GOOGLE_SHEET_ID=

# fixture — демо из fixtures/ui_demo.json. sqlite — те же данные, что движок, файл var/autopilot.sqlite.
UI_STORE=fixture
# demo подставляет вымышленный профиль. live без OPERATOR_* не стартует и ничего не выдумывает.
OFFICE_MODE=demo
PRODUCT_NAME=Erstantwort
OPERATOR_NAME=
OPERATOR_BUERO=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_CITY=
# false: в Google Sheet не пишутся почта и телефон. true включает их явно.
SHEET_INCLUDE_CONTACT=false

# file | smtp. smtp вместе с UI_STORE=sqlite.
MAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=

# log | telegram
TELEGRAM_MODE=log
TELEGRAM_BOT_TOKEN=
# true: бот сам читает сообщения (long polling) и отвечает на /start, /help и любой другой текст.
# Выключено, пока вы явно не поставите true. В демо и в тестах сеть не трогается.
BOT_POLLING=false

# Домен catch-all для тестовых лидов, НЕ example.org и не testdomain.de.
# Пример: lead.agentur.de
LEAD_DOMAIN=
# Домен в нашем Message-ID. Тот же домен, с которого реально уходит почта.
MAIL_DOMAIN=

# off | imap. imap вместе с UI_STORE=sqlite. Секреты только здесь.
IMAP_MODE=off
IMAP_POLL_SECONDS=60
IMAP_SILENCE_MINUTES=15
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURE=true
IMAP_FOLDER=INBOX

SLOT_RULES={"days":[1,7],"hours":[10,18],"len_min":45,"buffer_min":15,"tz":"Europe/Berlin"}
MAKLER_PROFILE={"name":"Maria K.","buero":"Erstantwort Demo","adresse":"Johannisstraße 1, 90419 Nürnberg","telefon":"+49 911 0000000","impressum_url":"http://127.0.0.1:18791/impressum","datenschutz_url":"http://127.0.0.1:18791/datenschutz","telegram_user_id":"","from_email":"","from_name":"Maria K.","sheet_url":""}

ENGINE_PORT=8787
DATA_DIR=var

# Локальный редактор. В проде замените на https://makler.example.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:18080/
WEBHOOK_URL=http://localhost:18080/
N8N_SECURE_COOKIE=false

# Прод: домен n8n и домен Mini App. Почта для сертификата. CIDR офиса через пробел.
SITE_ADDRESS=hooks.ihre-domain.de
APP_ADDRESS=app.ihre-domain.de
ACME_EMAIL=admin@ihre-domain.de
EDITOR_ALLOW_CIDRS=127.0.0.1
ENGINE_PUBLISH_PORT=18787
WEB_PUBLISH_PORT=18791
# Короткое имя бюро, латиница. Пусто — в сигнал не подставляется.
OFFICE_SLUG=
# Куда писать «движок замолчал». Не id лида. Наружу уходит только при TELEGRAM_MODE=telegram.
OPS_TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID=
WATCH_INTERVAL_SECONDS=300
