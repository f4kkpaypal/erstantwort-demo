  {
   "id": "SC6",
   "name": "Telegram Business: окно 24 ч и права (N17)",
   "steps": [
    {
     "do": "business_message",
     "business_connection_id": "bc_test_1",
     "chat_id": "9400000001",
     "can_reply": true,
     "age_hours": 2,
     "text": "Hi, price?",
     "expect": {
      "lead": true,
      "send_allowed": true
     }
    },
    {
     "do": "business_message",
     "business_connection_id": "bc_test_2",
     "chat_id": "9400000002",
     "can_reply": false,
     "age_hours": 2,
     "text": "Hi, price?",
     "expect": {
      "lead": true,
      "send_allowed": false,
      "error_code": "cannot_reply"
     }
    },
    {
     "do": "send_after_hours",
     "chat_id": "9400000001",
     "hours": 25,
     "expect": {
      "send_allowed": false,
      "error_code": "window_closed"
     }
    },
    {
     "do": "business_message",
     "chat_id": "9999999999",
     "not_in_TG_TEST_LEAD_IDS": true,
     "text": "Hi",
     "expect": {
      "lead": false,
      "stored": false,
      "logged": false,
      "counter_dropped_non_test": 1
     }
    }
   ]
  },
  {
